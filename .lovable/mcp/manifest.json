{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://htldajjmjltkzwcodzhw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "barber-hub-pro",
      "version": "0.1.0",
      "title": "Barber Hub Pro"
    },
    "tools": [
      {
        "name": "list_shops",
        "title": "Listar barbearias da plataforma",
        "description": "Lista as barbearias visíveis para o usuário com slug, link público, plano (teste ou pro), status e fim do período de teste.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_services",
        "title": "Serviços e informações da barbearia",
        "description": "Retorna os dados de uma barbearia da plataforma: serviços com preços, horário de funcionamento, links e horários possíveis de agendamento.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "description": "Link da barbearia (ex.: navalha-de-ouro). Sem valor, usa a primeira ativa.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_barbers",
        "title": "Listar barbeiros",
        "description": "Lista a equipe da barbearia com nome, especialidade e WhatsApp comercial.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "Listar clientes",
        "description": "Lista os clientes cadastrados na barbearia com nome e WhatsApp.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_appointments",
        "title": "Listar agendamentos",
        "description": "Lista os agendamentos da agenda com cliente, barbeiro, serviço, data e horário. Aceita filtros opcionais por data e barbeiro.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from": {
              "description": "Data inicial (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "to": {
              "description": "Data final (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "barber_id": {
              "description": "ID do barbeiro.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_appointment",
        "title": "Criar agendamento",
        "description": "Cria uma reserva validada pela agenda da barbearia; conflitos, duração e expediente são verificados no banco.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "shop_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID da barbearia."
            },
            "service_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID do serviço (use list_services)."
            },
            "barber_id": {
              "description": "ID do barbeiro; omita para qualquer profissional.",
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "client_name": {
              "type": "string",
              "minLength": 2,
              "description": "Nome completo do cliente."
            },
            "client_whatsapp": {
              "type": "string",
              "minLength": 8,
              "description": "WhatsApp do cliente com DDD."
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data YYYY-MM-DD."
            },
            "time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$",
              "description": "Horário HH:mm."
            }
          },
          "required": [
            "shop_id",
            "service_id",
            "client_name",
            "client_whatsapp",
            "date",
            "time"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "cancel_appointment",
        "title": "Cancelar agendamento",
        "description": "Cancela (exclui) um agendamento da agenda pelo seu ID.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "appointment_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID do agendamento a cancelar."
            }
          },
          "required": [
            "appointment_id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
